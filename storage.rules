rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Bukti foto pengaduan lingkungan (Maksimal 5MB, format gambar saja)
    match /complaints/{complaintId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Dokumen permohonan surat (PDF/JPG/PNG max 5MB)
    match /letter_attachments/{userId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.role in ['SUPERADMIN', 'ADMIN_RT', 'SEKRETARIS']);
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && (request.resource.contentType.matches('application/pdf') || request.resource.contentType.matches('image/.*'));
    }

    // Laporan keuangan subfolder download (Khusus Pengurus RT & Superadmin)
    match /financial_reports/{fileName} {
      allow read, write: if request.auth != null && request.auth.token.role in ['SUPERADMIN', 'BENDAHARA', 'SEKRETARIS'];
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.role == 'SUPERADMIN';
    }
  }
}
