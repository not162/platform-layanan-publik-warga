# ==============================================================================
# Platform Layanan Publik Warga - Template Konfigurasi Lingkungan Produksi
# Diselaraskan dengan TOGAF ADM Phase H (Production & Deployment Baseline)
# ==============================================================================

APP_NAME="Platform Layanan Publik Warga"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://layanan-warga.kelurahan.go.id

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# Logging & Error Tracking
# ------------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# ------------------------------------------------------------------------------
# MySQL Enterprise Database (Cluster / Cloud)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=layanan_warga_production
DB_USERNAME=prod_warga_user
DB_PASSWORD=GantiDenganPasswordSangatKuatDanAcak123!
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ------------------------------------------------------------------------------
# Session Security (UU PDP Compliant)
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ------------------------------------------------------------------------------
# Cache & Memory Stores
# ------------------------------------------------------------------------------
CACHE_STORE=database
# CACHE_PREFIX=warga_cache_

# ------------------------------------------------------------------------------
# Queue & Background Workers
# ------------------------------------------------------------------------------
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# Real-Time Event Broadcasting (Pusher / Laravel Reverb)
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=ap1

# ------------------------------------------------------------------------------
# Storage Disks
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# Email / Notification Gateway
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@layanan-warga.kelurahan.go.id"
MAIL_FROM_NAME="${APP_NAME}"
